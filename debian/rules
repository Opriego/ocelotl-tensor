DEB_HOST_GNU_TYPE ?= $(shell dpkg-architecture -qDEB_HOST_GNU_TYPE)
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
LLVM_CMAKE_DIR := $(shell /usr/bin/llvm-config --cmakedir)
LLVM_CORE_ARCHIVE := $(shell /usr/bin/llvm-config --libdir)/libLLVMCore.a
LLVM_DEV_PACKAGE := $(firstword $(shell dpkg-query -S $(LLVM_CORE_ARCHIVE) 2>/dev/null | cut -d: -f1))
LLVM_STATIC_BUILT_USING := $(shell dpkg-query -W -f='$${source:Package} (= $${source:Version})' $(LLVM_DEV_PACKAGE))

%:
	dh $@ --buildsystem=cmake+ninja --builddirectory=obj-$(DEB_HOST_GNU_TYPE)

override_dh_auto_configure:
	dh_auto_configure --buildsystem=cmake+ninja -- \
		-DBUILD_TESTING=ON \
		-DLLVM_DIR=$(LLVM_CMAKE_DIR)

override_dh_gencontrol:
	test -n "$(LLVM_DEV_PACKAGE)"
	test -n "$(LLVM_STATIC_BUILT_USING)"
	dh_gencontrol -- -Vllvm:Static-Built-Using='$(LLVM_STATIC_BUILT_USING)'
